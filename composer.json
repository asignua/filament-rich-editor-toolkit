{
    "name": "asignua/filament-rich-editor-toolkit",
    "description": "Free plugins for the Filament 5 RichEditor: paste cleanup for Word and Google Docs, preserved class/id/style/data-* attributes, safe iframe and video embeds, image by URL and a toolbar that stays visible on long content.",
    "keywords": ["filament", "filament-plugin", "laravel", "rich-editor", "tiptap", "paste", "word", "iframe", "embed", "sticky-toolbar"],
    "homepage": "https://github.com/asignua/filament-rich-editor-toolkit",
    "support": {
        "issues": "https://github.com/asignua/filament-rich-editor-toolkit/issues",
        "source": "https://github.com/asignua/filament-rich-editor-toolkit"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mykhailo Hladchenko",
            "email": "myhailo@hotmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Asignua\\RichEditorToolkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asignua\\RichEditorToolkit\\Tests\\": "tests/PHP/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asignua\\RichEditorToolkit\\RichEditorToolkitServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
